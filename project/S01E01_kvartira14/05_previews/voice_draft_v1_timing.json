 "subs": [
  {
   "start": 0.8,
   "end": 3.4026666666666667,
   "text": "Жалоба на шум из квартиры номер четырнадцать.",
   "typed": false
  },
  {
   "start": 3.702666666666667,
   "end": 5.2060208333333335,
   "text": "Каждую ночь печатает!",
   "typed": false
  },
  {
   "start": 5.406020833333334,
   "end": 6.8246875000000005,
   "text": "И на одном месте замолкает!",
   "typed": false
  },
  {
   "start": 7.224687500000001,
   "end": 8.357479166666668,
   "text": "Тринадцать квартир.",
   "typed": false
  },
  {
   "start": 8.757479166666668,
   "end": 11.151979166666667,
   "text": "Кто-то незаконно построил четырнадцатую.",
   "typed": false
  },
  {
   "start": 11.451979166666668,
   "end": 13.919916666666667,
   "text": "Или она очень хорошо прячется…",
   "typed": false
  },
  {
   "start": 14.819916666666668,
   "end": 17.059916666666666,
   "text": "Вот и твоя прячущаяся квартира.",
   "typed": false
  },
  {
   "start": 17.359916666666667,
   "end": 18.98125,
   "text": "Я не говорил, что она добрая.",
   "typed": false
  },
  {
   "start": 21.78125,
   "end": 24.365270833333334,
   "text": "Откроем и оформим штраф за незаконную планировку.",
   "typed": false
  },
  {
   "start": 24.665270833333334,
   "end": 26.42310416666667,
   "text": "Слышал про профессиональный риск?",
   "typed": false
  },
  {
   "start": 26.72310416666667,
   "end": 28.250625000000003,
   "text": "Я работаю с документами.",
   "typed": false
  },
  {
   "start": 28.550625000000004,
   "end": 29.172562500000005,
   "text": "Именно.",
   "typed": false
  },
  {
   "start": 30.172562500000005,
   "end": 31.78135416666667,
   "text": "Она печатает про меня.",
   "typed": false
  },
  {
   "start": 32.381354166666675,
   "end": 34.73868750000001,
   "text": "Марк нашёл квартиру четырнадцать.",
   "typed": true
  },
  {
   "start": 35.088687500000006,
   "end": 36.57950000000001,
   "text": "Клякс испугался.",
   "typed": true
  },
  {
   "start": 36.97950000000001,
   "end": 37.886166666666675,
   "text": "А потом…",
   "typed": true
  },
  {
   "start": 38.18616666666667,
   "end": 39.10995833333334,
   "text": "Я не испугался!",
   "typed": false
  },
  {
   "start": 39.90995833333334,
   "end": 40.54995833333334,
   "text": "Потом что?",
   "typed": false
  },
  {
   "start": 40.84995833333334,
   "end": 41.735291666666676,
   "text": "Она не знает.",
   "typed": false
  },
  {
   "start": 42.03529166666667,
   "end": 44.02627083333334,
   "text": "Поэтому печатает каждую ночь.",
   "typed": false
  },
  {
   "start": 44.42627083333334,
   "end": 46.31275000000001,
   "text": "Значит, незавершённое дело.",
   "typed": false
  },
  {
   "start": 48.41275,
   "end": 50.4269375,
   "text": "Технически, я предупреждал.",
   "typed": false
  },
  {
   "start": 51.626937500000004,
   "end": 52.306937500000004,
   "text": "Ладно.",
   "typed": false
  },
  {
   "start": 53.00693750000001,
   "end": 54.638958333333335,
   "text": "Это уже не моя смена.",
   "typed": false
  }
 ]
}